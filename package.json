{
  "name": "compass-conference",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp-hashes.mjs",
    "lint": "eslint app next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "serve out -l 3000",
    "pages:preview": "wrangler pages dev out",
    "pages:deploy": "wrangler pages deploy out"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.20",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "serve": "^14.2.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "wrangler": "^4.133.0"
  }
}
