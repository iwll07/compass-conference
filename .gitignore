# Playwright CLI output (may contain credentials)
.playwright-cli/
node_modules/
.next/
out/
.env*
!.env.example
*.tsbuildinfo
.wrangler/
.vercel/
playwright-report/
test-results/
.impeccable/
.agents/
.claude/

# Scratch logs from local verification runs (lint/build/QA/LCP timings)
.logs/

# Local scratch: temp verification scripts and their output. Named with a
# leading dot + .txt/.tmp so they sort together and never belong in a commit.
scripts/tmp-*
.*.txt
.*.tmp

# `npm run preview` (serve out) writes its access log to the repo root. The
# .logs/ entry above is a DIRECTORY pattern and does not cover this file.
.preview.log

# Tool-local agent instructions, not site source. AGENTS.md is auto-generated by
# `next dev` (node_modules/next/dist/server/lib/generate-agent-files.js) and
# CLAUDE.md is a one-line `@AGENTS.md` pointer for Claude Code. Neither is part
# of the conference site, and neither is read at runtime, so both stay local.
AGENTS.md
CLAUDE.md

