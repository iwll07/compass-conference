# Playwright CLI output (may contain credentials)
.playwright-cli/
node_modules/
.next/
out/
.env*
!.env.example
*.tsbuildinfo
.wrangler/
.vercel/
playwright-report/
test-results/
.impeccable/
.agents/
.claude/

# Scratch logs from local verification runs (lint/build/QA/LCP timings)
.logs/

# Local scratch: temp verification scripts and their output. Named with a
# leading dot + .txt/.tmp so they sort together and never belong in a commit.
scripts/tmp-*
.*.txt
.*.tmp

