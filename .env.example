# Supabase — project URL and PUBLISHABLE key.
#
# Copy to .env.local and fill in. The publishable key is safe to ship to the
# browser: it only grants what Row Level Security allows. Never put a secret
# (sb_secret_…) or legacy service_role key here — those bypass RLS and must
# never reach a client bundle.
#
# The project is not linked to the Supabase CLI, so apply the schema in
# supabase/migrations/ manually via the dashboard SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
